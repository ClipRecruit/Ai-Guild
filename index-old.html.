<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>AI Guild · Prototype</title><style>
:root{font-family:ui-sans-serif,system-ui;color:#f9e8bd;background:#161224}*{box-sizing:border-box}body{margin:0}header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 18px;background:#29213a;border-bottom:3px solid #7e5a45}h1{margin:0;font-size:21px}small{color:#c8b9c9}button,select{font:inherit;cursor:pointer}button{background:#594075;border:2px solid #9d7eae;color:#fff1d6;border-radius:9px;padding:10px 13px}button:active{transform:scale(.98)}button:disabled{opacity:.45;cursor:not-allowed}.shell{max-width:1250px;margin:auto;padding:14px;display:grid;grid-template-columns:minmax(0,1.7fr) minmax(285px,1fr);gap:14px}.scene{background:#251d36;border:4px solid #826047;border-radius:13px;overflow:hidden;position:relative}canvas{width:100%;height:auto;display:block;image-rendering:pixelated;touch-action:manipulation}.hint{padding:9px 12px;color:#dfc5a5;background:#29213a;font-size:13px}.panel{background:#2b223d;border:3px solid #856348;border-radius:12px;padding:15px}.panel h2{font-size:18px;margin:0 0 12px}.roster{display:flex;gap:7px;flex-wrap:wrap}.roster button.active{background:#82599c;border-color:#e2b766}.profile{display:flex;gap:13px;align-items:center;margin:17px 0}.portrait{font-size:38px;background:#4c385f;border-radius:12px;padding:10px}.meta{color:#cbb9ce;font-size:13px}.status{color:#95e6a6}.task{padding:12px;background:#3c304d;border-radius:9px;margin:12px 0}.progress{height:12px;background:#1d1929;border-radius:20px;overflow:hidden;margin-top:10px}.fill{height:100%;background:#8ee39c;width:0%;transition:width .4s}.controls{display:flex;flex-wrap:wrap;gap:8px}.controls button{flex:1}.log{font-size:13px;color:#e1cddd;max-height:175px;overflow:auto;padding-left:19px}.log li{margin:7px 0}.footer{max-width:1250px;margin:0 auto 25px;padding:0 15px;color:#b4a5bf;font-size:12px}.tag{background:#483452;padding:5px 8px;border-radius:6px;font-size:12px}@media(max-width:760px){.shell{grid-template-columns:1fr;padding:8px;gap:8px}.panel{padding:12px}header{padding:11px}h1{font-size:18px}}
</style></head><body><header><div><h1>✦ AI Guild <span class="tag">v0.1</span></h1><small>Fantasy workforce simulator</small></div><button id="reset">Reset village</button></header><main class="shell"><section class="scene"><canvas id="world" width="640" height="420" aria-label="Pixel art fantasy village with three clickable agents"></canvas><div class="hint">✨ Tap a character or its building to inspect the agent. Simulated tasks only — no AI account connections.</div></section><section class="panel"><h2>Guild members</h2><div class="roster" id="roster"></div><div class="profile"><div class="portrait" id="portrait">🧙</div><div><strong id="name">Sage</strong><div class="meta" id="role">Researcher</div><div class="status" id="status">Idle</div></div></div><label for="taskSelect">Assign a quest</label><div class="task"><select id="taskSelect" style="width:100%;background:#231c31;color:#fff1d6;padding:10px;border:1px solid #80638c;border-radius:7px"></select><div style="display:flex;justify-content:space-between;margin-top:13px"><span id="taskName">No active quest</span><span id="percent">0%</span></div><div class="progress"><div class="fill" id="fill"></div></div></div><div class="controls"><button id="start">▶ Start quest</button><button id="pause">Ⅱ Pause</button></div><h2 style="margin-top:23px">Guild activity</h2><ol class="log" id="log"></ol></section></main><div class="footer">Prototype runs locally in Safari. Quest progress is simulated and saves in this browser. No downloads, sign-ins, or API keys required to test it.</div><script>
const definitions=[{id:'sage',name:'Sage',role:'Researcher',emoji:'🧙',x:149,y:220,color:'#9575df',tasks:['Research product trends','Compare competitor shops','Summarize market opportunities']},{id:'pixel',name:'Pixel',role:'Creator',emoji:'🧝',x:333,y:220,color:'#f3a76d',tasks:['Design a product concept','Draft product descriptions','Create a content plan']},{id:'merlin',name:'Merlin',role:'Merchant',emoji:'🧙‍♂️',x:518,y:220,color:'#82c6a3',tasks:['Prepare a draft listing','Review shop checklist','Plan product launch']}];const key='ai-guild-v01';let saved;try{saved=JSON.parse(localStorage.getItem(key)||'null')}catch{};let agents=definitions.map(d=>({...d,...(saved?.agents?.find(a=>a.id===d.id)||{}),tasks:d.tasks}));let selected=saved?.selected||'sage';let history=saved?.history||['Welcome to AI Guild. Choose a worker and assign a quest.'];let last=performance.now();const $=id=>document.getElementById(id);function persist(){try{localStorage.setItem(key,JSON.stringify({agents:agents.map(({id,task,progress,running})=>({id,task,progress,running})),selected,history}))}catch{}}function log(s){history.unshift(s);history=history.slice(0,20);persist()}function active(){return agents.find(a=>a.id===selected)}function render(){const a=active();$('roster').innerHTML='';agents.forEach(agent=>{const b=document.createElement('button');b.className=agent.id===selected?'active':'';b.textContent=agent.emoji+' '+agent.name;b.onclick=()=>{selected=agent.id;persist();render()};$('roster').appendChild(b)});$('portrait').textContent=a.emoji;$('name').textContent=a.name;$('role').textContent=a.role;$('status').textContent=a.running?'● Working':a.task&&a.progress>=100?'✓ Completed':a.task?'Ⅱ Paused':'○ Idle';$('taskSelect').innerHTML='';a.tasks.forEach(t=>{const o=document.createElement('option');o.value=t;o.textContent=t;$('taskSelect').appendChild(o)});$('taskSelect').value=a.task&&a.tasks.includes(a.task)?a.task:a.tasks[0];$('taskName').textContent=a.task||'No active quest';$('percent').textContent=Math.floor(a.progress||0)+'%';$('fill').style.width=(a.progress||0)+'%';$('pause').disabled=!a.running;$('log').innerHTML='';history.slice(0,10).forEach(h=>{const li=document.createElement('li');li.textContent=h;$('log').appendChild(li)})}function start(){let a=active(),t=$('taskSelect').value;if(a.task!==t||a.progress>=100){a.progress=0;a.task=t}a.running=true;log(a.name+' started: '+t);render()}$('start').onclick=start;$('pause').onclick=()=>{let a=active();a.running=false;log(a.name+' paused: '+a.task);render()};$('reset').onclick=()=>{if(!confirm('Reset all simulated quests and progress?'))return;agents=definitions.map(d=>({...d}));selected='sage';history=['Village reset.'];persist();render()};$('taskSelect').onchange=()=>{};
const c=$('world'),ctx=c.getContext('2d');ctx.imageSmoothingEnabled=false;const W=640,H=420;function rect(x,y,w,h,col){ctx.fillStyle=col;ctx.fillRect(Math.round(x),Math.round(y),Math.round(w),Math.round(h))}function text(s,x,y,size=12,col='#fff0c5'){ctx.font=`bold ${size}px monospace`;ctx.textAlign='center';ctx.fillStyle='#1c1428';ctx.fillText(s,x+1,y+2);ctx.fillStyle=col;ctx.fillText(s,x,y)}function tree(x,y,s=1){rect(x-7*s,y,14*s,42*s,'#5b382e');for(let i=0;i<5;i++){rect(x+(-36+i*12)*s,y-32*s+(i%2)*6*s,36*s,30*s,['#28604a','#337e53','#4a955a'][i%3])}rect(x-10*s,y-24*s,22*s,14*s,'#68aa60')}function hut(x,y,w,color,label){rect(x-4,y+38,w+8,7,'#37283d');rect(x,y-3,w,100,'#704b43');rect(x+7,y+10,w-14,80,'#bb8b5c');for(let i=0;i<5;i++)rect(x-12+i*(w+24)/5,y-13-i%2*4,(w+24)/5+2,19,color);rect(x+w/2-14,y+46,28,51,'#392943');rect(x+12,y+28,22,24,'#3e7191');rect(x+15,y+31,16,18,'#a5e4ef');rect(x-7,y-31,w+14,23,'#e4bd83');text(label,x+w/2,y-15,13,'#38233b')}
function agentSprite(a,t){const bounce=a.running?Math.round(Math.sin(t/240)*3):0;let x=a.x,y=a.y+bounce;rect(x-12,y+27,25,5,'#251c32');rect(x-8,y+13,6,14,'#342c53');rect(x+3,y+13,6,14,'#342c53');rect(x-11,y-3,23,19,a.color);rect(x-8,y-20,17,18,'#f3c19c');rect(x-6,y-14,3,3,'#251b35');rect(x+4,y-14,3,3,'#251b35');rect(x-15,y-23,31,7,a.color);rect(x-5,y-36,12,15,a.color);rect(x+14,y+2,4,17,'#a77b4e');rect(x+12,y-2,9,8,'#ffe9a1');if(a.running){rect(x+20,y-15,4,4,'#fff2a1');rect(x-19,y-5,3,3,'#d1c2ff')}if(a.id===selected){ctx.strokeStyle='#ffe48d';ctx.lineWidth=2;ctx.strokeRect(x-20,y-42,40,77)}text(a.name,x,y-48,12);if(a.running)text('⚒',x+25,y-29,16)}function draw(t){let sky=ctx.createLinearGradient(0,0,0,300);sky.addColorStop(0,'#37305d');sky.addColorStop(1,'#9c7bb5');rect(0,0,W,H,sky);for(let i=0;i<55;i++){let x=(i*113+17)%640,y=(i*47+21)%170;rect(x,y,2,2,i%3?'#c9b5e0':'#fff2b5')}for(let i=0;i<12;i++){let x=i*67-25;rect(x,155+(i%3)*13,78,125,i%2?'#454568':'#514e76')}rect(0,264,W,156,'#386349');for(let i=0;i<55;i++){let x=(i*79+23)%640,y=272+(i*31)%140;rect(x,y,9,6,i%3?'#4d8a50':'#7db761')}for(let i=0;i<14;i++)rect(i*50-20,326+(i%2)*9,42,14,'#a18365');tree(44,188,.75);tree(602,183,.8);hut(64,150,155,'#66519a','RESEARCH');hut(246,150,155,'#8c5c91','CREATION');hut(428,150,155,'#6d8b82','MERCHANT');rect(271,325,98,48,'#66576c');rect(281,335,78,29,'#a88c76');rect(303,304,33,47,'#4e4189');rect(310,295,19,45,'#ba8aff');rect(315,306,9,25,'#f0d9ff');text('GUILD CRYSTAL',320,395,13);agents.forEach(a=>agentSprite(a,t));text('THE ENCHANTED GUILD',320,37,23,'#ffe6a6');requestAnimationFrame(draw)}c.addEventListener('pointerdown',e=>{const r=c.getBoundingClientRect(),x=(e.clientX-r.left)*W/r.width,y=(e.clientY-r.top)*H/r.height;const a=agents.find(a=>Math.abs(a.x-x)<65&&y>120&&y<285);if(a){selected=a.id;persist();render()}});function tick(now){const delta=Math.min(now-last,200);last=now;let changed=false;agents.forEach(a=>{if(a.running){a.progress=Math.min(100,(a.progress||0)+delta/800);changed=true;if(a.progress>=100){a.running=false;log(a.name+' completed: '+a.task)}}});if(changed){persist();const a=active();$('percent').textContent=Math.floor(a.progress||0)+'%';$('fill').style.width=(a.progress||0)+'%';$('status').textContent=a.running?'● Working':a.progress>=100?'✓ Completed':'Ⅱ Paused';if(a.progress>=100)render()}setTimeout(()=>requestAnimationFrame(tick),100)}render();requestAnimationFrame(draw);requestAnimationFrame(tick);
</script></body></html>
